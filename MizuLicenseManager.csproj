<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Mizu-License-Manager</AssemblyName>
    <ApplicationIcon>Assets/Mizu-White.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <RootNamespace>MizuLicenseManager</RootNamespace>
  </PropertyGroup>
  <ItemGroup><Compile Remove="tests/**/*.cs" /></ItemGroup>
  <ItemGroup><Using Remove="System.Windows.Forms"/><Using Remove="System.Drawing"/></ItemGroup>
  <ItemGroup><Resource Include="Assets/Mizu-Black.ico" /><Resource Include="Assets/Mizu-White.ico" /></ItemGroup>
</Project>
